@page "{id:int?}"
@model BugTrackingSystem.Pages.Bugs.IndexModel
@using BugTrackingSystem.Models
@{
    ViewData["Title"] = "Список багів";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>@(Model.ProjectName ?? "Усі баги")</h1>
        <div>
            <a asp-page="./Create" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i> Додати баг
            </a>
            @if (Model.ProjectId.HasValue)
            {
                <a asp-page="/Projects/Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> До проєктів
                </a>
            }
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Заголовок</th>
                        <th>Статус</th>
                        <th>Пріоритет</th>
                        <th>Автор</th>
                        <th class="text-end">Дії</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var bug in Model.Bugs)
                    {
                        var priorityClass = bug.Priority switch
                        {
                            BugPriority.High => "bg-danger",
                            BugPriority.Medium => "bg-warning text-dark",
                            BugPriority.Low => "bg-success",
                            _ => "bg-secondary"
                        };

                        var statusClass = bug.Status switch
                        {
                            BugStatus.New => "bg-primary",
                            BugStatus.InProgress => "bg-info text-dark",
                            BugStatus.Resolved => "bg-success",
                            BugStatus.Closed => "bg-secondary",
                            _ => "bg-secondary"
                        };

                        <tr>
                            <td class="align-middle">
                                <strong>@bug.Title</strong>
                            </td>
                            <td class="align-middle">
                                <span class="badge @statusClass">
                                    @bug.Status.GetDisplayName()
                                </span>
                            </td>
                            <td class="align-middle">
                                <span class="badge @priorityClass">
                                    @bug.Priority.GetDisplayName()
                                </span>
                            </td>
                            <td class="align-middle text-muted small">
                                @bug.Author?.UserName
                            </td>
                            <td class="text-end align-middle">
                                <div class="btn-group btn-group-sm">
                                    <a asp-page="./Details" asp-route-id="@bug.Id" class="btn btn-outline-secondary" title="Переглянути">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-page="./Edit" asp-route-id="@bug.Id" class="btn btn-outline-warning" title="Редагувати">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    @if (Model.DeletableBugIds.Contains(bug.Id))
                                    {
                                        <a asp-page="./Delete" asp-route-id="@bug.Id" class="btn btn-outline-danger" title="Видалити">
                                            <i class="bi bi-trash3"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>