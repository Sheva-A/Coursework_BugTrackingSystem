@page
@model BugTrackingSystem.Pages.Projects.IndexModel
@{
    ViewData["Title"] = "Проєкти";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Проєкти</h1>
    @if (Model.IsAdminOrManager)
    {
        <a asp-page="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Додати проєкт
        </a>
    }
</div>

@if (!Model.Projects.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> Наразі немає проєктів, до яких ви маєте доступ.
    </div>
}
else
{
    <div class="row">
        @foreach (var item in Model.Projects)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title text-primary">@item.Name</h5>
                        <p class="card-text text-muted">@item.Description</p>
                    </div>
                    <div class="card-footer bg-transparent border-top-0 d-flex gap-2 flex-wrap">
                        <a asp-page="/Bugs/Index" asp-route-projectId="@item.Id"
                           class="btn btn-sm btn-outline-primary flex-grow-1">
                            <i class="bi bi-bug"></i> Баги проєкту
                        </a>
                        @if (Model.ManageableProjectIds.Contains(item.Id))
                        {
                            <a asp-page="Edit" asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-warning" title="Редагувати">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-page="Delete" asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-danger" title="Видалити">
                                <i class="bi bi-trash3"></i>
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}