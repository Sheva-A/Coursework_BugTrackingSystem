@page "{id:int}"
@model BugTrackingSystem.Pages.Projects.DeleteModel
@{
    ViewData["Title"] = "Видалення проєкту";
}

<div class="container" style="max-width:640px;">
    <div class="text-center mb-4">
        <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-danger bg-opacity-10 mb-3"
             style="width:72px;height:72px;">
            <i class="bi bi-folder-x text-danger" style="font-size:2rem;"></i>
        </div>
        <h1 class="h3 fw-bold">Видалення проєкту</h1>
        <p class="text-muted">Цю дію неможливо скасувати.</p>
    </div>

    <div class="card shadow-sm border-danger border-opacity-25 mb-4">
        <div class="card-body">
            <h5 class="card-title fw-bold">@Model.Project.Name</h5>
            <p class="card-text text-muted">@Model.Project.Description</p>
        </div>
        <ul class="list-group list-group-flush">
            <li class="list-group-item d-flex justify-content-between">
                <span class="text-muted">Учасників</span>
                <strong>@Model.Project.Members.Count</strong>
            </li>
            <li class="list-group-item d-flex justify-content-between">
                <span class="text-muted">Прив'язаних багів</span>
                <strong>@Model.BugCount</strong>
            </li>
        </ul>
    </div>

    @if (Model.BugCount > 0)
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <strong>@Model.BugCount</strong> баг(ів) прив'язано до цього проєкту.
            Вони <strong>не будуть видалені</strong>, але втратять прив'язку до проєкту.
        </div>
    }

    <div class="d-flex gap-2 justify-content-end">
        <a asp-page="./Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Скасувати
        </a>
        <form method="post">
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash3"></i> Так, видалити
            </button>
        </form>
    </div>
</div>
